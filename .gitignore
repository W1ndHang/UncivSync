# Source-only publication: deny files by default, then allow reviewed project paths.
# Directories stay traversable so nested source and asset rules can match.
*
!*/

# Public project documents and shared configuration
!/.gitignore
!/README.md
!/LICENSE
!/CREDITS.md
!/client/LICENSE
!/server/LICENSE
!/client/.editorconfig
!/client/.gitattributes

# Local screenshot-maintenance notes
/SCREENSHOTS.md

# Gradle build files and the required wrapper bootstrap JAR
!/client/gradlew
!/client/gradlew.bat
!/client/gradle.properties
!/client/build.gradle.kts
!/client/settings.gradle.kts
!/client/gradle/libs.versions.toml
!/client/gradle/wrapper/gradle-wrapper.properties
!/client/gradle/wrapper/gradle-wrapper.jar
!/client/buildSrc/build.gradle.kts
!/client/buildSrc/settings.gradle.kts
!/client/buildSrc/src/**/*.kt
!/client/core/build.gradle.kts
!/client/desktop/build.gradle.kts
!/client/android/build.gradle.kts
!/client/server/build.gradle.kts

# Production client / game-core source
!/client/core/src/**/*.kt
!/client/core/src/**/*.java
!/client/desktop/src/**/*.kt
!/client/desktop/src/**/*.java
!/client/android/src/**/*.kt
!/client/android/src/**/*.java
!/client/android/src/**/*.aidl
!/client/server/src/**/*.kt
!/client/server/src/**/*.java
!/client/android/AndroidManifest.xml
!/client/android/proguard-rules.pro
!/client/android/project.properties

# Built-in artwork, rulesets, translations, audio and Android resources
!/client/android/res/**/*.xml
!/client/android/res/**/*.png
!/client/android/res/**/*.webp
!/client/android/res/**/*.ttf
!/client/android/Images*/**/*.png
!/client/android/Images*/**/*.jpg
!/client/android/Images*/**/*.svg
!/client/android/Images*/**/*.xcf
!/client/android/Images*/**/TexturePacker.settings
!/client/android/ImagesToNotAddToGame/SVGExport/.gitkeep
!/client/android/assets/*.atlas
!/client/android/assets/*.png
!/client/android/assets/Atlases.json
!/client/android/assets/Skin.json
!/client/android/assets/uiskin.json
!/client/android/assets/*.fnt
!/client/android/assets/ExcludedModAuthors.txt
!/client/android/assets/ExtraImages/**/*.png
!/client/android/assets/ExtraImages/**/*.jpg
!/client/android/assets/effects/**/*.p
!/client/android/assets/jsons/Civ V - Vanilla/*.json
!/client/android/assets/jsons/Civ V - Gods & Kings/*.json
!/client/android/assets/jsons/TileSets/**/*.json
!/client/android/assets/jsons/translations/*.properties
!/client/android/assets/jsons/ModCategories.json
!/client/android/assets/jsons/Tutorials.json
!/client/android/assets/jsons/WesnothImportMappings.json
!/client/android/assets/sounds/**/*.mp3
!/client/android/assets/sounds/**/*.ogg
!/client/android/assets/sounds/**/*.wav

# Build-time icons and explicitly vendored Discord native dependencies
!/client/extraImages/Icons/*.ico
!/client/extraImages/Icons/*.png
!/client/desktop/discord_rpc/darwin/libdiscord-rpc.dylib
!/client/desktop/discord_rpc/linux-x86/libdiscord-rpc.so
!/client/desktop/discord_rpc/linux-x86-64/libdiscord-rpc.so
!/client/desktop/discord_rpc/win32-x86/discord-rpc.dll
!/client/desktop/discord_rpc/win32-x86-64/discord-rpc.dll
!/client/desktop/packrConfig.json
!/client/desktop/linuxFilesForJar/*.sh
!/client/server/packrConfig.json
!/client/server/linuxFilesForJar/*.sh

# Public README images: only the deliberately selected filenames
!/client/preview/.gitkeep
!/client/preview/client-connection.png
!/client/preview/create-game.png
!/client/preview/admin-overview.png
!/client/preview/admin-room-detail.png

# Production authoritative server and build/export helpers
!/server/src/*.java
!/server/src/launch4j-config.xml
!/server/src/Unciv.ico
!/server/src/build-launch4j.bat
!/server/build.py
!/server/deploy-client.py
!/server/pack-release.py
!/server/project_layout.py

# Local tests, fixtures, reproductions and generated contract samples never publish.
**/[Tt]est/
**/[Tt]ests/
**/[Ff]ixtures/
**/[Tt]est[Dd]ata/
**/[Tt]estdata/
**/*Test*.java
**/*Test*.kt
**/*Repro*.java
**/*Repro*.kt
**/*Fixture*.java
**/*Fixture*.kt
**/*Benchmark*.java
**/*Benchmark*.kt
**/*_test.py
**/test_*.py
/server/src/FsGenFixture.java
/server/src/OpsCoverage.java
/server/ws_test.py
/server/stress_test.py
/client/fs-contract-sim-sample.json

# All compiled products and local runtime deployments remain on this computer.
/releases/
**/build/
**/build-test/
**/dist/
**/deploy/
**/.gradle/
**/.kotlin/
**/__pycache__/
**/node_modules/
**/*.class
**/*.pyc
**/*.pyo

# Player identities, saves, maps, scenarios, downloaded mods and personal caches
**/[Ss]aves/
**/[Ss]aves_backup/
**/[Ss]aveFiles/
**/[Mm]ultiplayerGames/
**/[Mm]ultiplayerFiles/
/client/maps/
/client/mods/
/client/fonts/
/client/music/
/client/scenarios/
/client/android/assets/maps/
/client/android/assets/mods/
/client/android/assets/fonts/
/client/android/assets/music/
/client/android/assets/scenarios/
**/GameSettings.json
**/FasterUIDevSettings.json
**/ModListCache.json
**/admin-settings.json
**/*.civs.json
**/*_Preview.json
**/*.auth
**/server.auth
**/.players.json
**/lasterror.txt
**/*.log
**/*.dmp
**/hs_err_pid*

# Local SDK / IDE settings, credentials and private signing keys
**/local.properties
**/.idea/
**/.vscode/
**/.run/
**/.settings/
**/.classpath
**/.project
**/.env
**/.env.*
**/*.jks
**/*.keystore
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/Thumbs.db
**/.DS_Store
